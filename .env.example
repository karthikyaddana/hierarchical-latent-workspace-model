# Azure access uses Entra (az login); no Azure key is ever stored.
# Optional overrides for the Azure pipeline:
# HLWM_AZURE_ENDPOINT=
# HLWM_AZURE_DEPLOYMENT=
# HLWM_MAX_WORKERS=8
# HLWM_REQUESTS_PER_MINUTE=60

# NVIDIA integrate API key for the builder factory's Nemotron teacher.
# Export it in your shell for the session instead of writing it here:
#   export NVIDIA_API_KEY=nvapi-...
# Rotate the key after a generation campaign or if it was ever pasted in a chat.
NVIDIA_API_KEY=
